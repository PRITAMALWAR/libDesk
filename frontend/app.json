{
  "expo": {
    "name": "LibDesk",
    "slug": "libdesk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/libdesk-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.libdesk.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "09bd1638-b8f8-4153-a64b-38fd33b99859"
      },
      "apiPort": 5001,
      "apiProductionUrl": "https://libdesk.onrender.com"
    },
    "updates": {
      "url": "https://u.expo.dev/09bd1638-b8f8-4153-a64b-38fd33b99859"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "pritamkumars-organization",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "plugins": [
      "expo-asset",
      "expo-secure-store",
      "expo-font",
      "@react-native-community/datetimepicker"
    ]
  }
}
