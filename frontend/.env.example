# Default API is https://libdesk.onrender.com (see app.json expo.extra.apiProductionUrl).
# Set this only when you want a different backend (e.g. local):
# EXPO_PUBLIC_API_URL=http://192.168.1.10:5001

# Local backend port — only used if apiProductionUrl is removed from app.json.
# EXPO_PUBLIC_API_PORT=5001
